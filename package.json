{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Playwright framework for UI (ParaBank), multi-tab (Herokuapp), and API (ReqRes, mocks)",
  "scripts": {
    "prepare": "playwright install",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "debug": "PWDEBUG=1 playwright test",
    "report": "playwright show-report",
    "trace:show": "playwright show-trace trace.zip"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
